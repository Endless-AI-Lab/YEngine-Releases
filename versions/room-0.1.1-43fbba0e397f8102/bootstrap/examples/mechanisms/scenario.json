{
  "version": 1,
  "name": "door-and-drawer",
  "actions": [
    { "kind": "mode", "mode": "preview" },
    { "kind": "pose", "joints": { "door-hinge": 1.2, "drawer-slide": 0.4 } },
    {
      "kind": "assert",
      "path": "mechanisms.preview.joints[door-hinge].position",
      "op": "near",
      "value": 1.2,
      "tolerance": 0.00001
    },
    { "kind": "capture", "name": "preview-open" },
    { "kind": "mode", "mode": "physics" },
    {
      "kind": "physics",
      "operations": [
        {
          "kind": "set-motor",
          "entity": "door-hinge",
          "motor": {
            "mode": "position",
            "target": 1.2,
            "maxEffort": 40,
            "frequencyHz": 12,
            "dampingRatio": 1
          }
        },
        {
          "kind": "set-motor",
          "entity": "drawer-slide",
          "motor": {
            "mode": "position",
            "target": 0.4,
            "maxEffort": 40,
            "frequencyHz": 12,
            "dampingRatio": 1
          }
        }
      ]
    },
    { "kind": "step", "count": 120 },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[door-hinge].state.position",
      "op": "near",
      "value": 1.2,
      "tolerance": 0.02
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[drawer-slide].state.position",
      "op": "near",
      "value": 0.4,
      "tolerance": 0.005
    },
    { "kind": "capture", "name": "physics-open" },
    { "kind": "reset" },
    {
      "kind": "physics",
      "operations": [
        {
          "kind": "set-pose",
          "entity": "drawer-stop",
          "pose": { "position": [1, 0.8, 0.65], "rotation": [0, 0, 0, 1] }
        },
        {
          "kind": "set-motor",
          "entity": "drawer-slide",
          "motor": {
            "mode": "position",
            "target": 0.5,
            "maxEffort": 40,
            "frequencyHz": 12,
            "dampingRatio": 1
          }
        }
      ]
    },
    { "kind": "step", "count": 120 },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[drawer-slide].state.motor.target",
      "op": "eq",
      "value": 0.5
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[drawer-slide].state.position",
      "op": "between",
      "value": [0.2, 0.35]
    },
    { "kind": "capture", "name": "physics-blocked" },
    {
      "kind": "physics",
      "operations": [
        {
          "kind": "set-motor",
          "entity": "drawer-slide",
          "motor": { "mode": "off" }
        },
        { "kind": "impulse", "entity": "drawer", "value": [0, 0, -0.6] }
      ]
    },
    { "kind": "step", "count": 60 },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[drawer-slide].state.motor.mode",
      "op": "eq",
      "value": "off"
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[drawer-slide].state.position",
      "op": "lt",
      "value": 0.15
    },
    { "kind": "capture", "name": "physics-released" },
    { "kind": "mode", "mode": "preview" },
    {
      "kind": "assert",
      "path": "mechanisms.preview.joints[door-hinge].position",
      "op": "eq",
      "value": 0
    }
  ]
}
