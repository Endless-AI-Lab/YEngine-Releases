{
  "version": 1,
  "name": "physical-button-door-and-knob-drawer",
  "actions": [
    {
      "kind": "mode",
      "mode": "physics"
    },
    {
      "kind": "input",
      "control": "open-button",
      "value": 1
    },
    {
      "kind": "step",
      "count": 150
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[open-button].pressed",
      "op": "eq",
      "value": true
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[door-hinge].state.position",
      "op": "near",
      "value": 1.4,
      "tolerance": 0.02
    },
    {
      "kind": "capture",
      "name": "pressed-open"
    },
    {
      "kind": "input",
      "control": "open-button",
      "value": 0
    },
    {
      "kind": "step",
      "count": 150
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[open-button].pressed",
      "op": "eq",
      "value": false
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[door-hinge].state.position",
      "op": "near",
      "value": 0,
      "tolerance": 0.02
    },
    {
      "kind": "capture",
      "name": "released-closed"
    },
    {
      "kind": "reset"
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[open-button].input",
      "op": "eq",
      "value": 0
    },
    {
      "kind": "input",
      "control": "drawer-knob",
      "value": 0.6
    },
    {
      "kind": "step",
      "count": 120
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[drawer-knob].value",
      "op": "near",
      "value": 0.6,
      "tolerance": 0.01
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[knob-hinge].state.position",
      "op": "near",
      "value": 0.96,
      "tolerance": 0.02
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0.3,
      "tolerance": 0.01
    },
    {
      "kind": "capture",
      "name": "knob-drawer-middle"
    },
    {
      "kind": "step",
      "count": 60
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[drawer-knob].input",
      "op": "eq",
      "value": 0.6
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0.3,
      "tolerance": 0.01
    },
    {
      "kind": "input",
      "control": "drawer-knob",
      "value": 1
    },
    {
      "kind": "step",
      "count": 120
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0.5,
      "tolerance": 0.01
    },
    {
      "kind": "capture",
      "name": "knob-drawer-open"
    },
    {
      "kind": "reset"
    },
    {
      "kind": "physics",
      "operations": [
        {
          "kind": "set-pose",
          "entity": "controlled-drawer-stop",
          "pose": {
            "position": [
              1.8,
              0.7,
              0.65
            ],
            "rotation": [
              0,
              0,
              0,
              1
            ]
          }
        }
      ]
    },
    {
      "kind": "input",
      "control": "drawer-knob",
      "value": 1
    },
    {
      "kind": "step",
      "count": 120
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[drawer-knob].value",
      "op": "near",
      "value": 1,
      "tolerance": 0.01
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.motor.target",
      "op": "near",
      "value": 0.5,
      "tolerance": 0.01
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "between",
      "value": [
        0.2,
        0.35
      ]
    },
    {
      "kind": "capture",
      "name": "knob-drawer-blocked"
    },
    {
      "kind": "physics",
      "operations": [
        {
          "kind": "set-pose",
          "entity": "controlled-drawer-stop",
          "pose": {
            "position": [
              3,
              0.7,
              0.65
            ],
            "rotation": [
              0,
              0,
              0,
              1
            ]
          }
        },
        {
          "kind": "wake",
          "entity": "controlled-drawer"
        }
      ]
    },
    {
      "kind": "step",
      "count": 120
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0.5,
      "tolerance": 0.01
    },
    {
      "kind": "capture",
      "name": "knob-drawer-unblocked"
    },
    {
      "kind": "input",
      "control": "drawer-knob",
      "value": 0
    },
    {
      "kind": "step",
      "count": 120
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0,
      "tolerance": 0.01
    },
    {
      "kind": "reset"
    },
    {
      "kind": "assert",
      "path": "mechanisms.interactions.state.controls[drawer-knob].input",
      "op": "eq",
      "value": 0
    },
    {
      "kind": "assert",
      "path": "mechanisms.physics.state.joints[controlled-drawer-slide].state.position",
      "op": "near",
      "value": 0,
      "tolerance": 0.01
    }
  ]
}
